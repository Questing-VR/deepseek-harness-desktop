{
    "name":  "@local/rsi-ui",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "main":  "index.mjs",
    "exports":  {
                    ".":  "./index.mjs",
                    "./client":  "./client.js",
                    "./cordis.patch.yml":  "./cordis.patch.yml",
                    "./package.json":  "./package.json"
                },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "inject":  [
                                              "@deepseek-ai/dsh-client-ui-sidebar",
                                              "@deepseek-ai/dsh-client-ui-renderer"
                                          ],
                               "platform":  "web"
                           }
            }
}